<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export an App Store build to a local .ipa. Xcode registers the bundle ID and creates the
	     distribution profile as needed. Use with: xcodebuild -exportArchive -allowProvisioningUpdates -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>M85BW7JMH8</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
